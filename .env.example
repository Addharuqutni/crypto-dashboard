# App runtime
# Dev default: scheduler runs in-process + API on-demand (page updates live).
# Prod VPS overrides via ecosystem.config.cjs (PM2): scheduler disabled, screener
# runs as a separate process writing data/screener/*.json (file mode).
DISABLE_SCREENER_SCHEDULER=0

# Screener runtime mode.
# file = /api/screener reads persisted scheduler/worker output (last run = real).
# on-demand = /api/screener runs a fresh cycle per request (last run = now).
SCREENER_STORAGE_MODE=file
SCREENER_STORAGE_BACKEND=file
SCREENER_REQUIRE_DATABASE=0
CRON_SECRET=change-this-long-random-secret
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Python screener universe (agent run_screener(None)).
# top_futures_volume = top active Binance USD-M USDT linear perpetuals by 24h quote volume.
SCREENER_UNIVERSE_MODE=top_futures_volume
SCREENER_MAX_SYMBOLS=100
SCREENER_UNIVERSE_CACHE_TTL_MINUTES=30
# Explicit SCREENER_SYMBOLS override wins over dynamic resolution (comma-separated).
# Leave empty to use dynamic top-100 futures quote-volume universe.
SCREENER_SYMBOLS=
SCREENER_CANDLE_LIMIT=120
SCREENER_MAX_CONCURRENT_SYMBOLS=3
# Screener cycle interval in minutes (1-1440). Lower = more frequent Binance hits → rate-limit risk.
SCREENER_INTERVAL_MINUTES=15

# Optional Basic Auth for private production deployments.
# Leave BASIC_AUTH_ENABLED unset or 0 for public dashboards.
BASIC_AUTH_ENABLED=0
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-this-long-random-password

# Optional server-side AI audit used by the screener scheduler/script.
# The browser AI settings are separate and user-provided.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Worker / Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WORKER_SYMBOLS=BTCUSDT
WORKER_INTERVAL_MIN=15
WORKER_SETUP_TF=30m
WORKER_MACRO_TF=4h
WORKER_TRIGGER_TF=15m
WORKER_ALERT_COOLDOWN_MIN=60
WORKER_MIN_CONFIDENCE=65
WORKER_SEND_WAIT_ALERTS=false
WORKER_SEND_HEALTH_ALERTS=true
WORKER_HEALTH_ALERTS_PER_HOUR=1
WORKER_DATA_DIR=./data/worker
WORKER_CONTINUE_ON_TELEGRAM_FAILURE=true
